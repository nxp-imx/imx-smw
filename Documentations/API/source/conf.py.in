# -- Path setup --------------------------------------------------------------

# If extensions (or modules to document with autodoc) are in another directory,
# add these directories to sys.path here. If the directory is relative to the
# documentation root, use os.path.abspath to make it absolute, like shown here.
#
# import os
# import sys
# sys.path.insert(0, os.path.abspath('.'))

import os, sys
sys.path.insert(0, os.path.abspath("${DOC_API_SOURCE_DIR}/_exts"))  # where kdoc_structs.py is

# -- Project information -----------------------------------------------------

project = 'Security Middleware Library - SMW'
copyright = '${PROJECT_COPYRIGHT}'
author = 'NXP'

# The full version, including alpha/beta/rc tags
release = '${CMAKE_PROJECT_VERSION}'


# -- General configuration ---------------------------------------------------

# Add any Sphinx extension module names here, as strings. They can be
# extensions coming with Sphinx (named 'sphinx.ext.*') or your custom
# ones.
extensions = [
  'linuxdoc.rstKernelDoc',    # Implementation of the 'kernel-doc' reST-directive.
  'kdoc_extension',           # Custom extension from _exts directory
  'linuxdoc.rstFlatTable',    # Implementation of the 'flat-table' reST-directive.
  'linuxdoc.kernel_include',  # Implementation of the 'kernel-include' reST-directive.
  'linuxdoc.manKernelDoc',    # Implementation of the 'kernel-doc-man' builder
  'linuxdoc.cdomain',         # Replacement for the sphinx c-domain.
  'linuxdoc.kfigure',         # Sphinx extension which implements scalable image handling.
]

# Add any paths that contain templates here, relative to this directory.
templates_path = ['_templates']

# List of patterns, relative to source directory, that match files and
# directories to ignore when looking for source files.
# This pattern also affects html_static_path and html_extra_path.
exclude_patterns = []

master_doc='index'

# -- Options for HTML output -------------------------------------------------

# The theme to use for HTML and HTML Help pages.  See the documentation for
# a list of builtin themes.
#
html_theme = 'sphinx_rtd_theme'
numfig = True

# Add any paths that contain custom static files (such as style sheets) here,
# relative to this directory. They are copied after the builtin static files,
# so a file named "default.css" will overwrite the builtin "default.css".
html_static_path = ['${CMAKE_SOURCE_DIR}/Documentations/API/source/_static']

# These paths are either relative to html_static_path
# or fully qualified paths (eg. https://...)
html_css_files = [
    'css/custom.css',
]

latex_documents = [('index', 'SecurityMiddleware_API.tex', project, author, 'manual')]
latex_table_style = ['tabularx', 'longtable']
latex_elements = {

    # Document settings
    'extraclassoptions': 'openany,oneside',
    'papersize': 'a4paper',
    'pointsize': '11pt',

    # --- MAIN PREAMBLE ---
    'preamble': r'''

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%                FONT AND BASIC SETUP
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\usepackage[none]{hyphenat}
\usepackage{titlesec}

% Deeper section numbering and ToC
\setcounter{secnumdepth}{4}
\setcounter{tocdepth}{3}

% Fonts
\usepackage{helvet}
\renewcommand{\familydefault}{\sfdefault}   % main font
\usepackage{courier}                        % mono font
\usepackage[T1]{fontenc}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%                PANDOC‑STYLE TABLES + AUTOSIZING
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Professional horizontal rules (Pandoc uses booktabs)
\usepackage{booktabs}

% % Column stretching + text wrapping
\usepackage{array}
\usepackage{tabularx}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}

% Enable tabularx autosizing across page breaks
\usepackage{ltablex}
\keepXColumns

% Remove Sphinx's alternating row colors (Pandoc has no shading)
\usepackage{xcolor}
\AtBeginEnvironment{tabular}{\rowcolors{0}{}{}}
\AtBeginEnvironment{longtable}{\rowcolors{0}{}{}}

% Slightly increased vertical spacing (Pandoc-like aesthetic)
\renewcommand{\arraystretch}{1.2}

% Longtable spacing fixes
\setlength{\LTpre}{0pt}
\setlength{\LTpost}{0pt}

% Table font size (optional)
\usepackage{etoolbox}
\AtBeginEnvironment{tabular}{\small}
\AtBeginEnvironment{longtable}{\small}

% --- Keep longtable rows from starting without space, safely ---
\usepackage{needspace}

\makeatletter
% 1) Before every longtable starts, reserve some vertical space
\pretocmd{\LT@start}{\needspace{12\baselineskip}}{}{}

% 2) Before each *row* (vertical mode), ensure there is room.
%    Hooking \LT@row is safer than redefining \\ (=\LT@tabularcr).
\pretocmd{\LT@row}{\noalign{\needspace{8\baselineskip}}}{}{}
\makeatother


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%                PAGE FOOTER FIXES (SAFE VERSION)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\makeatletter
\fancypagestyle{normal}{
  \fancyhf{}
  \fancyfoot[R]{{\py@HeaderFamily\thepage}}
  \fancyfoot[L]{{\py@HeaderFamily\textcopyright\ Copyright ${PROJECT_COPYRIGHT}}}
}
\fancypagestyle{plain}{
  \fancyhf{}
  \fancyfoot[R]{{\py@HeaderFamily\thepage}}
  \fancyfoot[L]{{\py@HeaderFamily\textcopyright\ Copyright ${PROJECT_COPYRIGHT}}}
}
\makeatother

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
'''
}