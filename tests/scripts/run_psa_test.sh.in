#!/bin/sh

set -u

res=0
error=0

#
# Check if the ELE Daemon is present
# If not active, exit with an error
#
if [ -e /etc/systemd/system/nvm_daemon.service ]; then
  res=$(systemctl is-active nvm_daemon)
  if [ "${res}" != "active" ]; then
    echo "NVM Daemon is not active"
    exit 1
  fi
fi

if [ -z ${VALGRIND+x} ]; then
  @PROJECT_NAME@ -t @CMAKE_INSTALL_PREFIX@/@SMW_TESTS_TARGET_PSA_DIR@/@PSA_ARCH_TESTS@/@PSA_ARCH_TESTS_API_DIR@/@PSA_CUSTOM_TEST_LIST@
else
  valgrind --undef-value-errors=no --error-exitcode=2 --suppressions=./scripts/leaks.supp @PROJECT_NAME@ -t @CMAKE_INSTALL_PREFIX@/@SMW_TESTS_TARGET_PSA_DIR@/@PSA_ARCH_TESTS@/@PSA_ARCH_TESTS_API_DIR@/@PSA_CUSTOM_TEST_LIST@
fi
res=$?
if [ "${res}" -ne 0 ]
then
  echo "$2 test failed (${res})"
  error=1
fi

exit ${error}
