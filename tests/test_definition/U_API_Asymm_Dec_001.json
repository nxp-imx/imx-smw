{
	"keys": {
		"key 1": {
			"type": "RSA",
			"security_size": 2048,
			"attributes_list": [
				"TRANSIENT"
			],
			"usage": [
				"ENCRYPT",
				"DECRYPT"
			]
		}
	},
	"subtest 1": {
		"description": "Args pointer is NULL",
		"command": "ASYMMETRIC_DECRYPT",
		"test_error": "ARGS_NULL",
		"key_name": "key 1",
		"result": "SMW_STATUS_INVALID_PARAM"
	},
	"subtest 2": {
		"description": "Unsupported version no is set",
		"command": "ASYMMETRIC_DECRYPT",
		"version": 255,
		"key_name": "key 1",
		"enc_attr": [
			"RSA_PKCS1_V15"
		],
		"input": "0123456789abcdef1011121314151617",
		"result": "SMW_STATUS_VERSION_NOT_SUPPORTED"
	},
	"subtest 3": {
		"description": "Asymmetric decryption algo is not set",
		"command": "ASYMMETRIC_DECRYPT",
		"key_name": "key 1",
		"input": "0123456789abcdef1011121314151617",
		"result": "SMW_STATUS_INVALID_PARAM"
	},
	"subtest 4": {
		"description": "Input length is set while input buffer is not set",
		"command": "ASYMMETRIC_DECRYPT",
		"enc_attr": [
			"RSA_OAEP",
			"HASH=SHA256"
		],
		"input": 10,
		"output": 32,
		"key_name": "key 1",
		"result": "SMW_STATUS_INVALID_PARAM"
	},
	"subtest 5": {
		"description": "Input length is set to 0 while input buffer is set",
		"command": "ASYMMETRIC_DECRYPT",
		"enc_attr": [
			"RSA_OAEP",
			"HASH=SHA256"
		],
		"input": [
			0,
			"0123456789abcdef1011121314151617"
		],
		"output": 32,
		"key_name": "key 1",
		"result": "SMW_STATUS_INVALID_PARAM"
	},
	"subtest 6": {
		"description": "Output pointer is set and output length is not set",
		"command": "ASYMMETRIC_DECRYPT",
		"enc_attr": [
			"RSA_OAEP",
			"HASH=SHA256"
		],
		"input": "0123456789abcdef1011121314151617",
		"output": [
			0,
			"0123456789abcdef1011121314151617"
		],
		"key_name": "key 1",
		"result": "SMW_STATUS_INVALID_PARAM"
	},
	"subtest 7": {
		"description": "Output pointer is not set",
		"command": "ASYMMETRIC_DECRYPT",
		"enc_attr": [
			"RSA_OAEP",
			"HASH=SHA256"
		],
		"input": "0123456789abcdef1011121314151617",
		"output": 0,
		"key_name": "key 1",
		"result": "SMW_STATUS_INVALID_PARAM"
	},
	"subtest 8": {
		"description": "Subsystem name is undefined",
		"command": "ASYMMETRIC_DECRYPT",
		"enc_attr": [
			"RSA_OAEP",
			"HASH=SHA256"
		],
		"key_name": "key 1",
		"input": "0123456789abcdef1011121314151617",
		"subsystem": "UNDEFINED",
		"result": "SMW_STATUS_UNKNOWN_SUBSYSTEM_NAME"
	}
}
