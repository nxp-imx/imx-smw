	"subtest 1": {
		"description": "Generate args pointer is NULL",
		"command": "GENERATE",
		"subsystem": "DEFAULT",
		"key_name": "key 1",
		"result": "SMW_STATUS_INVALID_PARAM",
		"test_error": "ARGS_NULL"
	},
	"subtest 2": {
		"description": "Key descriptor pointer is NULL",
		"command": "GENERATE",
		"subsystem": "DEFAULT",
		"key_name": "key 1",
		"result": "SMW_STATUS_INVALID_PARAM",
		"test_error": "KEY_DESC_NULL"
	},
	"subtest 3": {
		"description": "Key type is not set",
		"command": "GENERATE",
		"subsystem": "DEFAULT",
		"key_name": "key 2",
		"result": "SMW_STATUS_INVALID_PARAM"
	},
	"subtest 4": {
		"description": "Key security size is not set",
		"command": "GENERATE",
		"subsystem": "DEFAULT",
		"key_name": "key 3",
		"result": "SMW_STATUS_INVALID_PARAM"
	},
	"subtest 5": {
		"description": "Version is not supported",
		"command": "GENERATE",
		"subsystem": "DEFAULT",
