		"algo": "CMAC_TRUNCATED",
		"key_name": "key 1",
		"input": [
			"6bc1bee22e409f96e93d7e117393172a"
		],
		"output": 8,
		"depends": 1,
		"result": "SMW_STATUS_KEY_INVALID"
	},
	"subtest 7": {
		"command": "MAC_VERIFY",
		"algo": "CMAC",
		"key_name": "key 1",
		"input": [
			"6bc1bee22e409f96e93d7e117393172a"
		],
		"mac_id": 1,
		"depends": 4
	},
	"subtest 8": {
		"description": "Verify signature invalid",
		"command": "MAC_VERIFY",
		"algo": "CMAC",
		"key_name": "key 1",
		"input": [
			"bad1bee22e409f96e93d7e117393172a"
		],
		"mac_id": 1,
