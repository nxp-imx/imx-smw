{
	"keys": {
		"key 1": {
			"type": "AES",
			"security_size": 256,
			"attributes_list": [
				"TRANSIENT"
			],
			"usage": [
				"SIGN_MESSAGE",
				"VERIFY_MESSAGE"
			],
			"permitted_algo": [
				"CMAC"
			]
		}
	},
	"subtest 1": {
		"command": "GENERATE",
		"subsystem": "ELE",
		"key_name": "key 1"
	},
	"subtest 2": {
		"description": "Get the MAC size - Output buffer is NULL",
		"command": "MAC_COMPUTE",
		"algo": "CMAC",
		"key_name": "key 1",
		"input": [
			"6bc1bee22e409f96e93d7e117393172a"
		],
		"depends": 1,
		"result": "SMW_STATUS_OK"
	},
	"subtest 3": {
		"description": "Buffer too short",
		"command": "MAC_COMPUTE",
		"algo": "CMAC",
		"key_name": "key 1",
		"input": [
			"6bc1bee22e409f96e93d7e117393172a"
		],
		"output": [
			2,
			"012345"
		],
		"depends": 1,
		"result": "SMW_STATUS_OUTPUT_TOO_SHORT"
	},
	"subtest 4": {
		"command": "MAC_COMPUTE",
		"algo": "CMAC",
		"key_name": "key 1",
		"input": [
			"6bc1bee22e409f96e93d7e117393172a"
		],
		"output": 16,
		"mac_id": 1,
		"depends": 1
	},
	"subtest 5": {
		"command": "MAC_COMPUTE",
		"algo": "CMAC",
		"key_name": "key 1",
		"input": 0,
		"output": 16,
		"mac_id": 2,
		"depends": 1
	},
	"subtest 6": {
		"description": "MAC length truncated but key not valid",
