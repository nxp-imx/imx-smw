				"TRANSIENT"
			],
			"usage": [
				"SIGN_MESSAGE",
				"VERIFY_MESSAGE"
			],
			"permitted_algo": [
				"HMAC",
				"HASH=SHA256",
				"LENGTH=8"
			]
		},
		"key 2": {
