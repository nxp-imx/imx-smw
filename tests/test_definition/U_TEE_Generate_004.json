{
	"keys": {
		"key AES": {
			"type": "AES",
			"security_size": 128,
			"pub_key": 16,
			"usage": [
				"ENCRYPT"
			]
		},
		"key NIST 1": {
			"type": "NIST",
			"security_size": 192,
			"pub_key": 40,
			"usage": [
				"SIGN_MESSAGE"
			]
		},
		"key NIST 2": {
			"type": "NIST",
			"security_size": 192,
			"format": "BASE64",
			"pub_key": 40,
			"usage": [
				"SIGN_MESSAGE"
			]
		},
		"key RSA 1": {
			"type": "RSA",
			"security_size": 256,
			"pub_key": 3,
			"usage": [
				"SIGN_MESSAGE"
			]
		},
		"key RSA 2": {
			"type": "RSA",
			"security_size": 256,
			"modulus": 32,
			"usage": [
				"SIGN_MESSAGE"
			]
		},
		"key RSA 3": {
			"type": "RSA",
			"security_size": 256,
			"pub_key": 2,
			"modulus": 32,
			"usage": [
				"SIGN_MESSAGE"
			]
		},
		"key RSA 4": {
			"type": "RSA",
			"security_size": 256,
			"pub_key": 3,
			"modulus": 30,
			"usage": [
				"SIGN_MESSAGE"
			]
		},
		"key RSA 5": {
			"type": "RSA",
			"security_size": 256,
			"format": "BASE64",
			"pub_key": 3,
			"modulus": 44,
			"usage": [
				"SIGN_MESSAGE"
			]
		},
		"key RSA 6": {
			"type": "RSA",
			"security_size": 256,
			"format": "BASE64",
			"pub_key": 4,
			"modulus": 40,
			"usage": [
				"SIGN_MESSAGE"
			]
		}
	},
	"subtest 1": {
		"command": "GENERATE",
		"subsystem": "TEE",
		"key_name": "key AES",
		"result": "SMW_STATUS_OK"
	},
	"subtest 2": { // Public length is too short
		"command": "GENERATE",
		"subsystem": "TEE",
		"key_name": "key NIST 1",
		"result": "SMW_STATUS_OUTPUT_TOO_SHORT"
	},
	"subtest 3": { // Base64 public length is too short
		"command": "GENERATE",
		"subsystem": "TEE",
		"key_name": "key NIST 2",
		"result": "SMW_STATUS_OUTPUT_TOO_SHORT"
	},
	"subtest 4": { // Public buffer set but not modulus
		"command": "GENERATE",
		"subsystem": "TEE",
		"key_name": "key RSA 1",
		"result": "SMW_STATUS_INVALID_PARAM"
	},
	"subtest 5": { // Modulus buffer set but not public buffer
		"command": "GENERATE",
		"subsystem": "DEFAULT",
		"key_name": "key RSA 2",
		"result": "SMW_STATUS_OK"
	},
	"subtest 6": { // Public buffer len is too small
		"command": "GENERATE",
		"subsystem": "DEFAULT",
		"key_name": "key RSA 3",
		"result": "SMW_STATUS_OUTPUT_TOO_SHORT"
	},
	"subtest 7": { // Modulus buffer len is too small
		"command": "GENERATE",
		"subsystem": "DEFAULT",
		"key_name": "key RSA 4",
		"result": "SMW_STATUS_OUTPUT_TOO_SHORT"
	},
	"subtest 8": { // Public buffer len is too small (base64)
		"command": "GENERATE",
		"subsystem": "DEFAULT",
		"key_name": "key RSA 5",
		"result": "SMW_STATUS_OUTPUT_TOO_SHORT"
	},
	"subtest 9": { // Modulus buffer len is too small (base64)
		"command": "GENERATE",
		"subsystem": "DEFAULT",
		"key_name": "key RSA 6",
		"result": "SMW_STATUS_OUTPUT_TOO_SHORT"
	},
	"subtest 10": {
		"command": "DELETE",
		"key_name": "key AES",
		"depends": 1
	},
	"subtest 11": {
		"command": "DELETE",
		"key_name": "key RSA 2",
		"depends": 5
	}
}

